# =============================================================================
# QCHAIN DOCKER ENVIRONMENT CONFIGURATION
# =============================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  WHAT IS THIS FILE?                                                     │
# ├─────────────────────────────────────────────────────────────────────────┤
# │  This file contains settings (like port numbers) for Docker Compose.    │
# │  Docker reads these values when starting containers.                    │
# │                                                                         │
# │  .env.example = Template (committed to Git, shared with team)           │
# │  .env         = Your actual settings (NOT committed, personal copy)     │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  HOW TO USE                                                             │
# ├─────────────────────────────────────────────────────────────────────────┤
# │  1. Copy this file:   cp .env.example .env                              │
# │  2. Edit .env with your settings (the copy, not this template!)         │
# │  3. Run docker compose - it automatically reads .env                    │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  MULTIPLE DEVELOPERS ON SAME VM                                         │
# ├─────────────────────────────────────────────────────────────────────────┤
# │  If 4 team members share the same VM, each person can use different     │
# │  ports to avoid conflicts:                                              │
# │                                                                         │
# │  Developer 1: WEBAPP_PORT=3000                                          │
# │  Developer 2: WEBAPP_PORT=3001                                          │
# │  Developer 3: WEBAPP_PORT=3002                                          │
# │  Developer 4: WEBAPP_PORT=3003                                          │
# │                                                                         │
# │  (Or just share IPFS and take turns with other services)                │
# └─────────────────────────────────────────────────────────────────────────┘
#
# =============================================================================

# -----------------------------------------------------------------------------
# IPFS CONFIGURATION
# -----------------------------------------------------------------------------
# IPFS is the distributed file storage for documents and signatures

# API Port - Your Go code connects here to upload files
# Default: 5001 | Access at: http://localhost:5001
IPFS_API_PORT=5001

# Gateway Port - View uploaded files in browser
# Default: 8080 | Access at: http://localhost:8080/ipfs/<CID>
IPFS_GATEWAY_PORT=8080

# -----------------------------------------------------------------------------
# WEB APPLICATION PORTS
# -----------------------------------------------------------------------------

# Production webapp (compiled Flutter, served by Nginx)
# Access at: http://localhost:3000
WEBAPP_PORT=3000

# Development webapp (Flutter hot reload)
# Access at: http://localhost:8081
WEBAPP_DEV_PORT=8081

# -----------------------------------------------------------------------------
# DOCKER COMPOSE SETTINGS
# -----------------------------------------------------------------------------

# Project name - used as prefix for container names
# Containers will be named: qchain-ipfs, qchain-webapp, etc.
COMPOSE_PROJECT_NAME=qchain

# Default profile to start (uncomment one if you want a default)
# Options: bindings, native, web, full, mobile-dev, web-dev, native-dev
# COMPOSE_PROFILES=full
