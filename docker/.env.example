# =============================================================================
# QChain Docker Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# IPFS Configuration
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080

# Web Application Ports
WEBAPP_PORT=3000
WEBAPP_DEV_PORT=8081

# Project name (used as container prefix)
COMPOSE_PROJECT_NAME=qchain

# Default profile to use (options: bindings, native, web, full)
# COMPOSE_PROFILES=full
