# =============================================================================
# DOCKERIGNORE - Flutter Mobile App (UI_App)
# =============================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  WHAT IS THIS FILE?                                                     │
# ├─────────────────────────────────────────────────────────────────────────┤
# │  .dockerignore tells Docker which files to SKIP when building.          │
# │  It works exactly like .gitignore but for Docker builds.                │
# │                                                                         │
# │  Why skip files?                                                        │
# │  → Faster builds (less data to copy into container)                     │
# │  → Smaller images (don't include unnecessary files)                     │
# │  → Security (don't accidentally include secrets or logs)                │
# └─────────────────────────────────────────────────────────────────────────┘
#
# =============================================================================

# -----------------------------------------------------------------------------
# BUILD ARTIFACTS - Generated files that will be rebuilt inside container
# -----------------------------------------------------------------------------
build/              # Compiled app output
.dart_tool/         # Dart analyzer cache
.pub-cache/         # Downloaded packages (will re-download in container)
.pub/               # Pub temporary files

# -----------------------------------------------------------------------------
# IDE FILES - Editor settings (not needed for building)
# -----------------------------------------------------------------------------
.idea/              # IntelliJ/Android Studio settings
*.iml               # IntelliJ module files
.vscode/            # VS Code settings

# -----------------------------------------------------------------------------
# OS FILES - Operating system generated files
# -----------------------------------------------------------------------------
.DS_Store           # macOS folder metadata
*.log               # Log files

# -----------------------------------------------------------------------------
# GENERATED CODE - Code generated by build_runner (will regenerate)
# -----------------------------------------------------------------------------
*.g.dart            # Generated Dart files (JSON serialization, etc.)
*.freezed.dart      # Freezed-generated immutable classes

# -----------------------------------------------------------------------------
# LARGE CACHE DIRECTORIES - These are huge and will rebuild anyway
# -----------------------------------------------------------------------------
android/.gradle/    # Android Gradle cache (~500MB+)
ios/Pods/           # iOS CocoaPods dependencies

# -----------------------------------------------------------------------------
# DOCUMENTATION - Not needed for building the app
# -----------------------------------------------------------------------------
*.md                # Markdown documentation files

# -----------------------------------------------------------------------------
# GIT - Version control files (not needed in container)
# -----------------------------------------------------------------------------
.git                # Git repository data
.gitignore          # Git ignore file
